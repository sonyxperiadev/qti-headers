// Select kernel headers based on version

// This repo needs to live inside a parent dir of:
// kernel/sony/msm-X.Y/common-headers

// Use as follows:
// $(call soong_config_set,qti_kernel_headers,version,6.6)

bootstrap_go_package {
    name: "soong-qti_kernel_headers_defaults",
    pkgPath: "kernel/sony/qti-headers",
    deps: [
        "blueprint",
        "blueprint-pathtools",
        "soong",
        "soong-android",
        "soong-cc",
    ],
    srcs: [
        "kernel_headers.go",
    ],
    pluginFor: ["soong_build"],
}

qti_kernel_headers {
    name: "qti_kernel_headers",
    vendor_available: true,
    recovery_available: true,
}

// Techpack UAPI header modules. Each one is dummy unless
// common-headers/techpack-headers/<techpack> exists for the selected version
// (generated by cp_headers.py), then it re-exports <module name>_<version>.

// TODO: Validate. The BSP may require a different module name
// https://github.com/sonyxperiadev/vendor-qcom-opensource-camera-kernel/blob/1d3f989b7be114fe3a453c3024ee946e57f1eb92/include/uapi/Android.mk#L10
qti_techpack_headers {
    name: "camera-uapi",
    techpack: "camera",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "qseecom_kernel_headers",
    techpack: "securemsm",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "qti_audio_kernel_uapi",
    techpack: "audio",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "qti_display_kernel_headers",
    techpack: "display",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "qti_eva_kernel_headers",
    techpack: "eva",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "qti_gfx_kernel_uapi",
    techpack: "graphics",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "qti_ipa_kernel_headers",
    techpack: "dataipa",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "qti_ipa_test_kernel_headers",
    techpack: "dataipa",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "qti_mm_drivers_kernel_headers",
    techpack: "mm",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "qti_spu_drivers_kernel_headers",
    techpack: "spu",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "qti_synx_kernel_headers",
    techpack: "synx",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "qti_video_kernel_uapi",
    techpack: "video",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "securemsm_kernel_uapi_headers",
    techpack: "securemsm",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "smcinvoke_kernel_headers",
    techpack: "securemsm",
    vendor_available: true,
    recovery_available: true,
}

qti_techpack_headers {
    name: "smmu_proxy_uapi_header",
    techpack: "securemsm",
    vendor_available: true,
    recovery_available: true,
}

