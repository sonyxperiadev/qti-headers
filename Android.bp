// Select kernel headers based on version

// This repo needs to live inside a parent dir of:
// kernel/sony/msm-X.Y/common-headers

// Use as follows:
// SOONG_CONFIG_NAMESPACES += qti_kernel_headers
// SOONG_CONFIG_qti_kernel_headers := version
// SOONG_CONFIG_qti_kernel_headers_version := 4.14
// or
// $(call soong_config_set,qti_kernel_headers,version,4.14)

bootstrap_go_package {
    name: "soong-qti_kernel_headers_defaults",
    pkgPath: "kernel/sony/qti-headers",
    deps: [
        "blueprint",
        "blueprint-pathtools",
        "soong",
        "soong-android",
        "soong-cc",
    ],
    srcs: [
        "kernel_headers.go",
    ],
    pluginFor: ["soong_build"],
}

qti_kernel_headers_defaults {
    name: "qti_kernel_headers_defaults",
}

cc_library_headers {
    name: "qti_kernel_headers",
    defaults: ["qti_kernel_headers_defaults"],
    vendor_available: true,
    recovery_available: true,
}

// Dummy techpack UAPI header modules to satisfy dependencies
// All the headers we keep in the main qti_kernel_headers module
cc_library_headers {
    name: "qti_audio_kernel_uapi",
    vendor_available: true,
    recovery_available: true
}

cc_library_headers {
    name: "qti_display_kernel_headers",
    vendor_available: true,
    recovery_available: true
}

cc_library_headers {
    name: "qti_eva_kernel_headers",
    vendor_available: true,
    recovery_available: true
}

cc_library_headers {
    name: "qti_gfx_kernel_uapi",
    vendor_available: true,
    recovery_available: true
}

cc_library_headers {
    name: "qti_ipa_kernel_headers",
    vendor_available: true,
    recovery_available: true
}

cc_library_headers {
    name: "qti_ipa_test_kernel_headers",
    vendor_available: true,
    recovery_available: true
}

cc_library_headers {
    name: "qti_mm_drivers_kernel_headers",
    vendor_available: true,
    recovery_available: true
}

cc_library_headers {
    name: "qti_spu_drivers_kernel_headers",
    vendor_available: true,
    recovery_available: true
}

cc_library_headers {
    name: "qti_synx_kernel_headers",
    vendor_available: true,
    recovery_available: true
}

cc_library_headers {
    name: "qseecom_kernel_headers",
    vendor_available: true,
    recovery_available: true
}

cc_library_headers {
    name: "securemsm_kernel_uapi_headers",
    vendor_available: true,
    recovery_available: true
}

cc_library_headers {
    name: "smcinvoke_kernel_headers",
    vendor_available: true,
    recovery_available: true
}

cc_library_headers {
    name: "smmu_proxy_uapi_header",
    vendor_available: true,
    recovery_available: true
}
